# Copiá este archivo como .env y cambiá los datos.

# Conexión a PostgreSQL: postgres://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/BASE
DATABASE_URL=postgres://llantera:cambia-esta-clave@localhost:5432/llantera

# Puerto donde abre la página (http://localhost:3000)
PORT=3000

# Contraseña para entrar al sistema (recomendado si se usa desde internet).
# El navegador pide usuario y contraseña: el usuario puede ser cualquiera.
APP_PASSWORD=

# Poné true si tu proveedor de PostgreSQL en la nube exige SSL (Render, Railway, Supabase, Neon…)
PGSSL=false
